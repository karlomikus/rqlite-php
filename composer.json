{
    "name": "karlomikus/rqlite",
    "version": "0.3.0",
    "description": "A PHP client for rqlite",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kami\\Rqlite\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Karlo Mikuš",
            "email": "karlo.mikus1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 client and PSR-17 factories"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "symfony/var-dumper": "^7.1",
        "phpstan/phpstan": "^2.2",
        "guzzlehttp/guzzle": "^7.0",
        "pestphp/pest": "^3.5",
        "mockery/mockery": "^1.6",
        "rector/rector": "^2.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
